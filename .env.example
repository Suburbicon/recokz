# =====================================================================
# reco.kz — шаблон переменных окружения
# Скопируй в .env и заполни. Не коммить .env — он в .gitignore.
# =====================================================================

# ---------- Database (обязательно) ----------
# Postgres connection string. Локально можно поднять через Docker.
DATABASE_URL=postgresql://user:password@localhost:5432/recokz

# ---------- Clerk — аутентификация (обязательно для входа) ----------
# Берутся в Clerk Dashboard → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Кастомные роуты (обычно не нужно менять).
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/cabinet
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ---------- OpenAI — AI-парсинг и AI-сверка (опционально) ----------
# Без него: парсинг Excel (detectBank, detectTable*) и AI-сверка не работают.
OPENAI_API_KEY=sk-xxx

# ---------- Pusher — реалтайм для Rekassa-платежей (опционально) ----------
# Без него: создание платежа через onlineKKM не доедет до кассы в реалтайме.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# ---------- Rekassa — онлайн-касса (опционально) ----------
# Клиентский прокси к Rekassa API (используется в connection/rekassa и transactions/table).
NEXT_PUBLIC_API_REKASSA=https://api.rekassa.kz
NEXT_PUBLIC_API_KEY_REKASSA=

# Ключ для шифрования кредов Rekassa в таблице Conf.
# Должен быть base64 от 32 случайных байт. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Внимание: после смены ключа все сохранённые ранее креды Rekassa станут
# нерасшифровываемыми — потребуется пересохранение.
REKASSA_ENCRYPTION_KEY=
